# Qwen3.8-Flash-Next capture server for MTP self-distillation.
#
# The capture hook (files/ours/ar_speculator_capture.py, made by
# files/ours/patch_capture.py) replaces the autoregressive speculator. For each
# request with an X-Request-Id that contains cap-<row>, it writes the hidden
# states that feed the MTP head to {{captureDir}}. Use this profile only for the
# offline capture run. This profile reproduces the spark1 .env.capture of 2026-09-23,
# and adds the watchdog relief (MEMWATCH_RELIEF) that the recipe added later that day.
#
# Prefix caching stays on: the mamba block size of this model needs it. So the
# client must send a unique cache_salt with each request, or the hook does not
# see the positions that come from the prefix cache.
#
# pulse-recipe: qwen38-flash
# pulse-status: stable
# pulse-description: MTP hidden-state capture: capture hook, prefix cache on, client salts each request
# pulse-mkdir: {{captureDir}}
# pulse-proof: MTP index share: index_share_for_mtp_iteration ACTIVE
# pulse-client: send each request with a unique cache_salt and the header X-Request-Id: cap-<row>.
# pulse-client: distill/qwen38/capture_client.py does this (cache_salt capture-<row>).

IMAGE="vllm/vllm-openai:qwen38-flash-next"
SERVED_MODEL_NAME="qwen3.8-flash-next"
ABLIT=0

YARN=1
MAX_MODEL_LEN=262144
YARN_MAX_MODEL_LEN=524288

MTP_NUM_SPECULATIVE_TOKENS=3
MTP_DRAFT_VOCAB="files/draft_vocab_en_code_47k.txt"
MTP_K_SCHEDULE=""
MTP_INDEX_SHARE=1

KV_TARGET_GIB=20
HOST_RESERVE_GIB=32
HOST_SLACK_GIB=4
KV_CACHE_DTYPE=fp8
MAMBA_SSM_CACHE_DTYPE=bfloat16
# The watchdog drops the clean page cache one time before a MemFree stop (see best.env).
MEMWATCH_RELIEF=drop_caches

MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=2048
CUDAGRAPH_CAPTURE_SIZES=auto
COMPILATION_MODE=0

CHAT_TEMPLATE="files/chat-template/chat_template.jinja"

EXTRA_VLLM_ARGS="--kv-cache-memory-bytes 10737418240"
EXTRA_DOCKER_ARGS="
  -e VLLM_USE_V2_MODEL_RUNNER=1
  -e VLLM_MTP_CAPTURE_DIR=/cap
  -v {{captureDir}}:/cap
  -v {{recipeDir}}/files/ours/ar_speculator_capture.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/autoregressive/speculator.py:ro
"
