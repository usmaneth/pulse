# DRAFT. Qwen3.8-Flash-Next over two DGX Sparks with tensor parallel size 2.
#
# The single-Spark recipe cannot run this: its start.sh always sets tensor
# parallel size 1. This profile renders the .env of the separate two-node recipe
# (/models/usman/qwen38-dual). That recipe has spark1 as the head and spark2 as
# the worker, and its stop.sh stops the servers on both nodes. So `pulse model up`
# renders this profile and prints it, but it does not run it.
#
# The keys copy the effective values of /models/usman/qwen38-dual/.env of
# 2026-09-23. Nobody measured this profile against best.env.
#
# pulse-recipe: qwen38-dual
# pulse-status: experimental
# pulse-runnable: false
# pulse-description: DRAFT two-node TP2 with expert parallel (render only, not measured)

IMAGE="vllm/vllm-openai:qwen38-flash-next"
MODEL_ID="Mia-AiLab/Qwen3.8-Flash-Next-NVFP4"
SERVED_MODEL_NAME="qwen3.8-flash-next"
ABLIT=0
FP8_DENSE=false

HEAD_IP="{{headIp}}"
WORKER_IP="{{workerIp}}"
WORKER_USER=""
WORKER_HF_HOME="{{workerHfHome}}"
IFACE="{{iface}}"
IB_HCA="{{ibHca}}"
IB_GID_INDEX=3
MASTER_PORT=50000
NFS_SHARE=false
EVICT_PAGE_CACHE=true

TENSOR_PARALLEL_SIZE=2
ENABLE_EXPERT_PARALLEL=true
MM_ENCODER_TP_MODE=data
PLE_OFFLOAD=false
QSA_PROFILE=stock

MAX_MODEL_LEN=262144
YARN_ENABLE=false
YARN_FACTOR=4.0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

MTP_NUM_SPECULATIVE_TOKENS=3
MTP_DRAFT_VOCAB="files/draft_vocab_en_code_47k.txt"

GPU_MEMORY_UTILIZATION=0.835
KV_CACHE_DTYPE=fp8
MAMBA_SSM_CACHE_DTYPE=bfloat16
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
