# Qwen3.8-Flash-Next data generation for MTP self-distillation.
#
# Throughput profile: 8 sequences, native 262144 context, stock MTP head. It has
# no FP8 draft head, no block-drop backport, no index share and no r2 shard, so
# the generated text comes from the stock recipe. This profile reproduces the
# spark2 .env.datagen of 2026-09-23.
#
# pulse-recipe: qwen38-flash
# pulse-status: stable
# pulse-description: data generation: 8 sequences, 262144 context, stock MTP head
# pulse-client: gen_client.py sends 8 requests at the same time (--concurrency 8).

IMAGE="vllm/vllm-openai:qwen38-flash-next"
SERVED_MODEL_NAME="qwen3.8-flash-next"
ABLIT=0

# Context: YaRN off. The prompts are short, so the native 262144 context is enough.
YARN=0
MAX_MODEL_LEN=262144
YARN_MAX_MODEL_LEN=524288

MTP_NUM_SPECULATIVE_TOKENS=3
MTP_DRAFT_VOCAB="files/draft_vocab_en_code_47k.txt"
MTP_K_SCHEDULE=""

KV_TARGET_GIB=20
HOST_RESERVE_GIB=32
HOST_SLACK_GIB=4
KV_CACHE_DTYPE=fp8
MAMBA_SSM_CACHE_DTYPE=bfloat16

# Scheduler: the upstream recipe notes (README.md, .env.sample) give 162.9 tok/s
# in aggregate at 8 sequences against 113.7 at 4.
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=2048
CUDAGRAPH_CAPTURE_SIZES=auto
COMPILATION_MODE=0

CHAT_TEMPLATE="files/chat-template/chat_template.jinja"

# Pin the KV cache at 10 GiB (see best.env).
EXTRA_VLLM_ARGS="--kv-cache-memory-bytes 10737418240"
EXTRA_DOCKER_ARGS="-e VLLM_USE_V2_MODEL_RUNNER=1"
