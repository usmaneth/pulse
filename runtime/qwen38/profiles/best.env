# Qwen3.8-Flash-Next on one DGX Spark: the best measured single-stream profile.
#
# Measured on spark1 with one stream: code 55-60 tok/s, prose about 35-40 tok/s,
# 3.4-3.9 tokens per step on code, TTFT about 0.8-0.9 s on cached Codex turns.
# spark2 is about 8-10% faster than spark1 with the same config.
# Held-out acceptance bench: stock MTP head 2.960 tokens per step, r2 head 3.088.
#
# This file is a complete key set for the recipe .env. `pulse model up` adds the
# node keys (HF_HOME, BIND, PORT, REQUIRE_IDLE_GPU) from runtime/nodes.json and
# replaces {{name}} with the node variables. See docs/RUNTIME.md.
#
# pulse-recipe: qwen38-flash
# pulse-status: stable
# pulse-description: single Spark best: FP8 draft head, block-drop backport, MTP index share, r2 MTP head, 524288 context
# pulse-mkdir: {{tritonCache}}
# pulse-proof: MTP draft head: FP8 rowwise copy engaged
# pulse-proof: MTP index share: index_share_for_mtp_iteration ACTIVE
# pulse-proof: 'disable_eagle_block_drop': True

IMAGE="vllm/vllm-openai:qwen38-flash-next"
SERVED_MODEL_NAME="qwen3.8-flash-next"
ABLIT=0

# Context: YaRN on, so the server uses YARN_MAX_MODEL_LEN (524288 tokens).
YARN=1
MAX_MODEL_LEN=262144
YARN_MAX_MODEL_LEN=524288

# MTP speculative decoding with 3 draft tokens and the 47k reduced draft vocabulary.
MTP_NUM_SPECULATIVE_TOKENS=3
MTP_DRAFT_VOCAB="files/draft_vocab_en_code_47k.txt"
MTP_K_SCHEDULE=""
# Draft steps 1 and later reuse the sparse indices of step 0 (A/B 3).
MTP_INDEX_SHARE=1
# Keep the last prefix-cache block (vllm#53388 backport, mounted below).
MTP_DISABLE_BLOCK_DROP=1

# Memory. The desktop session and the CLI tools use about 22 GiB on spark1.
KV_TARGET_GIB=20
HOST_RESERVE_GIB=32
HOST_SLACK_GIB=4
KV_CACHE_DTYPE=fp8
MAMBA_SSM_CACHE_DTYPE=bfloat16

# Scheduler. 8192 batched tokens puts a typical Codex turn delta in one prefill chunk.
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
CUDAGRAPH_CAPTURE_SIZES=auto
COMPILATION_MODE=0

# Fixed chat template: reasoning_effort aliases and tool arguments as strings (Codex).
CHAT_TEMPLATE="files/chat-template/chat_template.jinja"

# Pin the KV cache at 10 GiB. Without the pin, vLLM profiled 21 GiB on a desktop
# host and the memory watchdog stopped the CUDA graph capture.
EXTRA_VLLM_ARGS="--kv-cache-memory-bytes 10737418240"

# V2 model runner, FP8 draft head, persistent Triton cache, block-drop backport
# (three vLLM files) and the self-distilled r2 MTP shard over shard 34.
EXTRA_DOCKER_ARGS="
  -e VLLM_USE_V2_MODEL_RUNNER=1
  -e VLLM_MTP_DRAFT_HEAD_FP8=1
  -e TRITON_CACHE_DIR=/triton-cache
  -v {{tritonCache}}:/triton-cache
  -v {{recipeDir}}/files/ours/speculative.py:/usr/local/lib/python3.12/dist-packages/vllm/config/speculative.py:ro
  -v {{recipeDir}}/files/ours/kv_cache_utils.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/kv_cache_utils.py:ro
  -v {{recipeDir}}/files/ours/scheduler.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/scheduler.py:ro
  -v {{mtpShardR2}}:/root/.cache/huggingface/hub/models--Mia-AiLab--Qwen3.8-Flash-Next-NVFP4/snapshots/{{hfSnapshot}}/model-00034-of-00034.safetensors:ro
"
