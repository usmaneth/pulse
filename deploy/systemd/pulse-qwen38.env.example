# Environment for pulse-qwen38.service. Values here override the JSON config.
# Copy to ~/.config/pulse/qwen38.env and edit.

# Listen address. Keep loopback unless other hosts must reach the gateway.
PULSE_GATEWAY_HOST=127.0.0.1
PULSE_GATEWAY_PORT=8800

# Backends in failover order, as name=url pairs. This replaces the endpoint
# list in the JSON config. Add spark2 only when its server is reachable at
# its own address.
PULSE_QWEN_BACKENDS=spark1=http://127.0.0.1:8888/v1

# Optional bearer key. When set, /v1/* needs "Authorization: Bearer <key>".
# /health and /metrics stay open.
#PULSE_GATEWAY_API_KEY=

# Optional Codex model catalog. /v1/models then returns the matching entries.
#PULSE_GATEWAY_MODEL_CATALOG=/path/to/.codex/model_catalog.all.json

# Log level: debug, info, warn or error.
PULSE_LOG_LEVEL=info
