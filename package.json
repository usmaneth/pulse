{
  "name": "pulse",
  "version": "1.0.0",
  "description": "Ultra-optimized, model-specialized inference engine for NVIDIA Blackwell (DGX Spark / GB10 / RTX 5090)",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "pulse": "./bin/pulse-cli"
  },
  "scripts": {
