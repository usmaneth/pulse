    "test:jev": "node --env-file=.env.local dist/jev/test.js"
  },
  "dependencies": {
    "ai": "^7.0.107"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
